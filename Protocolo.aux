\@writefile{lof}{\contentsline {figure}{\numberline {2.5}{\ignorespaces Comparación conformacional del complejo proteasa NS2B-NS3pro del virus del dengue serotipo 2 (DENV-2). \textbf  {Izquierda:} Conformación abierta e inactiva en estado \textit  {apo} (PDB ID: 2FOM). En esta forma, la región C-terminal del cofactor NS2B (amarillo) permanece desacoplada del dominio catalítico NS3 (cian). \textbf  {Derecha:} Conformación cerrada y activa (PDB ID: 2M9P), la cual muestra el reordenamiento del bucle C-terminal de NS2B alrededor de NS3 para estructurar el sitio activo. En ambas estructuras se resaltan en bastones (\textit  {sticks}) los residuos de la tríada catalítica (His51, Asp75 y Ser135) \cite  {li2020insights,de2011binding,maus2021sar}.\relax }}{10}{figure.2.5}\protected@file@percent }
\newlabel{fig:ns2b_ns3_comparacion}{{2.5}{10}{Comparación conformacional del complejo proteasa NS2B-NS3pro del virus del dengue serotipo 2 (DENV-2). \textbf {Izquierda:} Conformación abierta e inactiva en estado \textit {apo} (PDB ID: 2FOM). En esta forma, la región C-terminal del cofactor NS2B (amarillo) permanece desacoplada del dominio catalítico NS3 (cian). \textbf {Derecha:} Conformación cerrada y activa (PDB ID: 2M9P), la cual muestra el reordenamiento del bucle C-terminal de NS2B alrededor de NS3 para estructurar el sitio activo. En ambas estructuras se resaltan en bastones (\textit {sticks}) los residuos de la tríada catalítica (His51, Asp75 y Ser135) \cite {li2020insights,de2011binding,maus2021sar}.\relax }{figure.2.5}{}}
