\contentsline {figure}{\numberline {7.1}{\ignorespaces Isómeros propuestos para la primera adición de glicina al C\textsubscript {60}. La glicina se une al carbono C59; los círculos azules señalan el segundo carbono del enlace evaluado: (a) C43, (b) C58, (c) C11, (d) C10, (e) C50 y (f) C51.\relax }}{42}{figure.7.1}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces Estructuras seleccionadas durante la funcionalización secuencial de la jaula de C\textsubscript {60} con glicina. Los paneles muestran los sistemas con uno, dos, tres y cuatro grupos de glicina, respectivamente.\relax }}{44}{figure.7.2}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces Alternativas estructurales consideradas para continuar la funcionalización de C\textsubscript {60} con un tercer grupo de glicina. Los círculos azules indican los pares de carbonos evaluados como sitios de adición.\relax }}{45}{figure.7.3}%
\contentsline {figure}{\numberline {7.4}{\ignorespaces Alternativas estructurales consideradas para la cuarta adición de glicina al sistema C\textsubscript {60}(Gly)\textsubscript {3}. Los círculos azules señalan los pares de carbonos analizados para formar el complejo C\textsubscript {60}(Gly)\textsubscript {4}.\relax }}{46}{figure.7.4}%
\contentsline {figure}{\numberline {7.5}{\ignorespaces Estructuras optimizadas de los isómeros evaluados para la segunda adición de glicina al sistema C\textsubscript {60}(Gly). Los paneles (a)--(d) corresponden a las alternativas estructurales comparadas en esta etapa.\relax }}{49}{figure.7.5}%
\contentsline {figure}{\numberline {7.6}{\ignorespaces Distribución de los valores de potencial electrostático asociados con los sitios atómicos del fulereno C\textsubscript {60} y de los sistemas funcionalizados con una a cuatro moléculas de glicina. Las líneas verticales discontinuas separan los sistemas analizados.\relax }}{52}{figure.7.6}%
\contentsline {figure}{\numberline {7.7}{\ignorespaces Mapa de potencial electrostático molecular del sistema C\textsubscript {60}(Gly)\textsubscript {4} observado desde dos orientaciones. Los colores representan regiones de potencial negativo (rojo), cercano a cero (verde) y positivo (azul).\relax }}{53}{figure.7.7}%
\contentsline {figure}{\numberline {7.8}{\ignorespaces Diagramas de Ramachandran (MolProbity) para la estructura proteica inicial. Evaluación de la calidad estereoquímica del modelo nativo antes de los procesos de minimización de energía.\relax }}{55}{figure.7.8}%
\contentsline {figure}{\numberline {7.9}{\ignorespaces Diagramas de Ramachandran (MolProbity) tras el equilibrio NPT. Evaluación de la calidad estereoquímica de la estructura proteica al finalizar la etapa de equilibrio isotérmico-isobárico (NPT), previa a la fase de producción de dinámica molecular.\relax }}{57}{figure.7.9}%
