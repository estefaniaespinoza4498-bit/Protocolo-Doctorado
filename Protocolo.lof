\contentsline {figure}{\numberline {7.11}{\ignorespaces Evolución temporal del radio de giro ($R_g$) y del área superficial accesible al solvente (SASA) de la proteasa NS2B-NS3 durante 100 ns de dinámica molecular.}}{58}{figure.7.11}%
\contentsline {figure}{\numberline {7.12}{\ignorespaces Evolución temporal del número de enlaces de hidrógeno intramoleculares de la proteasa NS2B-NS3 durante 100 ns de dinámica molecular.}}{59}{figure.7.12}%
\contentsline {figure}{\numberline {7.13}{\ignorespaces Representación tridimensional del acoplamiento molecular del derivado de benzamida en la región propuesta como alostérica de la proteasa NS2B-NS3. Se muestran los contactos no covalentes identificados y sus distancias expresadas en \r A.}}{61}{figure.7.13}%
\contentsline {figure}{\numberline {7.14}{\ignorespaces Distribución de las 100 poses del derivado de benzamida según las puntuaciones de acoplamiento obtenidas mediante AutoDock Vina.}}{62}{figure.7.14}%
\contentsline {figure}{\numberline {7.15}{\ignorespaces Representación tridimensional del acoplamiento molecular del compuesto de referencia 246DA en la región ortostérica de la proteasa NS2B-NS3. Se muestran los contactos identificados y sus distancias expresadas en \r A.}}{64}{figure.7.15}%
\contentsline {figure}{\numberline {7.16}{\ignorespaces Distribución de las 100 poses del compuesto 246DA según las puntuaciones de acoplamiento obtenidas mediante AutoDock Vina.}}{65}{figure.7.16}%
\contentsline {figure}{\numberline {7.17}{\ignorespaces Representación tridimensional de una pose obtenida mediante acoplamiento ciego del derivado C$_{60}$(Gly)$_4$ con la proteasa NS2B-NS3.}}{66}{figure.7.17}%
\contentsline {figure}{\numberline {7.18}{\ignorespaces Distribución de las 100 poses obtenidas mediante acoplamiento ciego del derivado C$_{60}$(Gly)$_4$, agrupadas según su puntuación de AutoDock Vina.}}{67}{figure.7.18}%
\contentsline {figure}{\numberline {7.19}{\ignorespaces Representación tridimensional del acoplamiento dirigido del derivado C$_{60}$(Gly)$_4$ hacia la región propuesta como alostérica de la proteasa NS2B-NS3.}}{69}{figure.7.19}%
\contentsline {figure}{\numberline {7.20}{\ignorespaces Distribución de las 100 poses del derivado C$_{60}$(Gly)$_4$ obtenidas mediante acoplamiento dirigido hacia la región alostérica.}}{70}{figure.7.20}%
\contentsline {figure}{\numberline {7.21}{\ignorespaces Representación tridimensional del acoplamiento dirigido del derivado C$_{60}$(Gly)$_4$ hacia la región ortostérica de la proteasa NS2B-NS3.}}{72}{figure.7.21}%
\contentsline {figure}{\numberline {7.22}{\ignorespaces Distribución de las 100 poses del derivado C$_{60}$(Gly)$_4$ obtenidas mediante acoplamiento dirigido hacia la región ortostérica de la proteasa NS2B-NS3.}}{73}{figure.7.22}%
\contentsline {figure}{\numberline {7.23}{\ignorespaces Matrices de correlación cruzada dinámica (DCCM) obtenidas a partir de las trayectorias de 100 ns de la proteasa NS2B-NS3. \textbf {a)} C$_{60}$(Gly)$_4$ en la región alostérica; \textbf {b)} derivado de benzamida en la región alostérica; \textbf {c)} C$_{60}$(Gly)$_4$ en la región ortostérica; \textbf {d)} compuesto 246DA en la región ortostérica; \textbf {e)} C$_{60}$(Gly)$_4$ en la conformación obtenida mediante acoplamiento ciego; y \textbf {f)} proteína libre (Apo). Los tonos rojos representan correlaciones positivas, mientras que los azules corresponden a movimientos anticorrelacionados.}}{76}{figure.7.23}%
\contentsline {figure}{\numberline {7.24}{\ignorespaces {Evolución temporal del espacio conformacional (PCA común).} \textbf {a)} sitio alostérico con el ligando C$_{60}$(Gly)$_{4}$; \textbf {b)} sitio alostérico con un derivado de benzamida; \textbf {c)} sitio ortostérico con el ligando C$_{60}$(Gly)$_{4}$; \textbf {d)} sitio ortostérico con el ligando 246DA; \textbf {e)} acoplamiento ciego \textbf {f)} proteína en su conformación nativa (estado inactivo abierto).}}{82}{figure.7.24}%
\contentsline {figure}{\numberline {7.25}{\ignorespaces \textbf {Paisaje de energía libre (FEL) en el espacio conformacional.} \textbf {a)} sitio alostérico con el ligando C$_{60}$(Gly)$_{4}$; \textbf {b)} sitio alostérico con el ligando de benzamida; \textbf {c)} sitio ortostérico con el ligando C$_{60}$(Gly)$_{4}$; \textbf {d)} sitio ortostérico con el ligando 246DA; \textbf {e)} acoplamiento ciego \textbf {f)} proteína en su conformación nativa (estado inactivo abierto).}}{84}{figure.7.25}%
\contentsline {figure}{\numberline {7.26}{\ignorespaces Evolución temporal de la desviación cuadrática media (RMSD) de los átomos C$\alpha $ de la proteasa NS2B-NS3 en estado libre (\textit {Apo}) y en los sistemas con el derivado C$_{60}$(Gly)$_4$ y los compuestos de referencia, durante 100 ns de simulación.}}{87}{figure.7.26}%
\contentsline {figure}{\numberline {7.27}{\ignorespaces Proyección de las trayectorias de dinámica molecular sobre las dos primeras componentes principales de una base común de PCA durante 100~ns de simulación. \textbf {a)} C$_{60}$(Gly)$_4$ en la región alostérica; \textbf {b)} derivado de benzamida en la región alostérica; \textbf {c)} C$_{60}$(Gly)$_4$ en la región ortostérica; \textbf {d)} compuesto 246DA en la región ortostérica; \textbf {e)} C$_{60}$(Gly)$_4$ en la conformación obtenida mediante acoplamiento ciego; y \textbf {f)} proteína libre (\textit {apo}). La escala de color indica el tiempo de simulación.}}{89}{figure.7.27}%
\contentsline {figure}{\numberline {7.28}{\ignorespaces Raíz de la fluctuación cuadrática media (RMSF) de los átomos C$\alpha $, representada por índice de residuo, para NS2B--NS3 libre (\textit {apo}) y los sistemas con ligando durante 100~ns de simulación.}}{91}{figure.7.28}%
\contentsline {figure}{\numberline {7.29}{\ignorespaces Evolución temporal del área de superficie accesible al solvente (SASA) de la proteína NS2B--NS3, expresada en nm$^2$, para el sistema libre y los sistemas con ligando durante 100~ns de simulación.}}{92}{figure.7.29}%
\contentsline {figure}{\numberline {7.30}{\ignorespaces Evolución temporal del radio de giro ($R_g$) de la proteína NS2B--NS3 en estado libre y en los sistemas con ligando durante 100~ns de simulación.}}{93}{figure.7.30}%
